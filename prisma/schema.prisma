// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// NOTE (DATA-03): hosted on Vercel (serverless) → Postgres. Point DATABASE_URL at a
// hosted Postgres (Neon/Supabase free tier). Use the POOLED connection string on
// serverless so cold starts don't exhaust connections. Local dev connects to the same
// DATABASE_URL (a Neon branch or a local Postgres) — the app no longer uses SQLite.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// [SLIDE Registry Map] Store — one row per installed shop, self-registered via
// hooks.afterAuth (REG-01/REG-02). See app/lib/registrySync.server.ts.
model Store {
  id                 String    @id @default(cuid())
  shopifyDomain      String    @unique
  primaryDomain      String?
  status             String    @default("active")
  plan               String?
  contactEmail       String?
  themeName          String?
  themeVersion       String?
  grantedScopes      String?
  shippingModule     Boolean   @default(false) // [DEMO 5] write_shipping granted + module enabled
  dataConnected      Boolean   @default(false)
  fansifterConnected Boolean   @default(false)
  installedAt        DateTime  @default(now())
  uninstalledAt      DateTime?
  lastSyncedAt       DateTime?
}

// [DEMO 5] ShippingMethod — one row per merchant-defined checkout shipping method,
// mirrored 1:1 to a Shopify DeliveryMethodDefinition via deliveryProfileUpdate.
// shopifyMethodDefinitionId is the join key back to Shopify so delete retracts
// the same definition it created.
model ShippingMethod {
  id                        String    @id @default(cuid())
  shop                      String
  name                      String
  priceAmount               Decimal   @db.Decimal(10, 2)
  currencyCode              String
  conditionOperator         String?   // "AT_LEAST" | "AT_MOST" | null
  conditionAmount           Decimal?  @db.Decimal(10, 2)
  // Comma-joined DeliveryMethodDefinition ids — the mutation creates one DISTINCT
  // definition per zone, so a single merchant-facing "method" maps to N Shopify ids
  // (deliveryProfileUpdate's methodDefinitionsToDelete takes a flat id list, so no
  // zone/locationGroup bookkeeping is needed to retract them). Null until confirmed.
  shopifyMethodDefinitions  String?
  shopifyProfileId          String?
  createdAt                 DateTime  @default(now())

  @@index([shop])
}

// WebhookEvent — durable queue table (DATA-02); dedupe key is Shopify's own
// webhookId, not a generated cuid, so at-least-once deliveries are idempotent.
model WebhookEvent {
  id          String    @id // Shopify's webhookId — dedupe key, not a generated cuid
  topic       String
  shop        String
  payload     String    // JSON.stringify'd payload; SQLite has no native JSON column
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}
