# Shopify app credentials (from Partner Dashboard / shopify.app.toml client_id)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SEC-01 (Phase 2): comma-separated list of client secrets for rotation-safe webhook verification
SHOPIFY_CLIENT_SECRETS=

SCOPES=read_products,read_themes
# The app's public URL. Locally this is set by `shopify app dev`; on Vercel set it to the
# deployment URL (e.g. https://your-app.vercel.app) and update shopify.app.toml to match.
SHOPIFY_APP_URL=

# Hosted Postgres (Neon/Supabase free tier) — the app is serverless on Vercel, so SQLite
# is gone (DATA-03). Use the POOLED connection string at runtime so serverless cold starts
# don't exhaust connections. Run migrations (`prisma migrate deploy`) once against this URL.
DATABASE_URL=
