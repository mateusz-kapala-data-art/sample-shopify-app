# Shopify app credentials (from Partner Dashboard / shopify.app.toml client_id)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SEC-01 (Phase 2): comma-separated list of client secrets for rotation-safe webhook verification
SHOPIFY_CLIENT_SECRETS=

SCOPES=write_products,write_metaobjects,write_metaobject_definitions,read_themes
SHOPIFY_APP_URL=

# SQLite for demo; swap to a Postgres connection string for production (DATA-03)
DATABASE_URL="file:dev.sqlite"
